        "## Step 2: Defining the Graph Schema & Agent Query Simulation\n",
        "Here we structure our organization's knowledge schema using Cypher creation queries. The agent navigates relationships like `MEMBER_OF`, `WROTE`, `MADE`, and `DOCUMENTED_BY` to fetch precise answers without hallucinating."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import sys\n",
        "from falkordb import FalkorDB\n",
        "\n",
        "def initialize_company_brain():\n",
        "    print(\"Initializing Company Brain Graph Schema...\")\n",
        "\n",
        "    # Cypher query establishing nodes and relationships\n",
        "    setup_query = \"\"\"\n",
        "    CREATE\n",
        "      // People Nodes\n",
        "      (alice:Person {name: 'Alice Smith', role: 'Lead Architect'}),\n",
        "      (bob:Person {name: 'Bob Jones', role: 'Senior Backend Dev'}),\n",
        "      (charlie:Person {name: 'Charlie Brown', role: 'Product Manager'}),\n",
        "\n",
        "      // Team Nodes\n",
        "      (eng:Team {name: 'Core Engineering'}),\n",
        "      (prod:Team {name: 'Product Strategy'}),\n",
        "\n",
        "      // Project Nodes\n",
        "      (auth_proj:Project {name: 'OAuth2 Migration', status: 'Active'}),\n",
        "      (pay_proj:Project {name: 'Billing Gateway v2', status: 'In Planning'}),\n",
        "\n",
        "      // Documentation & Decision Nodes\n",
        "      (doc1:Document {title: 'Auth Architecture RFC', content: 'Migrating to OAuth2 for multi-tenant support and tighter security compliance.'}),\n",
        "      (doc2:Document {title: 'Q4 Billing Roadmap', content: 'Stripe integration scheduled to replace legacy processor by November.'}),\n",
        "      (dec1:Decision {topic: 'Authentication Protocol Choice', rationale: 'Chosen to solve cross-device session timeouts.'}),\n",
        "\n",
        "      // Graph Connections\n",
        "      (alice)-[:MEMBER_OF]->(eng),\n",
        "      (bob)-[:MEMBER_OF]->(eng),\n",
        "      (charlie)-[:MEMBER_OF]->(prod),\n",
        "\n",
        "      (alice)-[:WROTE]->(doc1),\n",
        "      (charlie)-[:WROTE]->(doc2),\n",
        "\n",
        "      (alice)-[:MADE]->(dec1),\n",
        "      (dec1)-[:AFFECTS]->(auth_proj),\n",
        "\n",
        "      (auth_proj)-[:DOCUMENTED_BY]->(doc1),\n",
        "      (pay_proj)-[:DOCUMENTED_BY]->(doc2),\n",
        "\n",
        "      (eng)-[:OWNS]->(auth_proj),\n",
        "      (prod)-[:OWNS]->(pay_proj)\n",
        "    \"\"\"\n",
        "    print(\"Schema successfully compiled for graph execution.\")\n",
        "    return setup_query\n",
        "\n",
        "def company_brain_agent_simulation(question_type):\n",
        "    \"\"\"\n",
        "    Simulates multi-hop graph traversal to resolve complex queries.\n",
        "    \"\"\"\n",
        "    if question_type == \"auth\":\n",
        "        print(\"🤖 Agent Query: 'Who owns the OAuth2 Migration project, who wrote its specs, and what was the core decision rationale?'\")\n",
        "        print(\"\\n--- Graph Traversal Results ---\")\n",
        "        print(\"• Owner Team: Core Engineering\")\n",
        "        print(\"• Lead Contributor: Alice Smith (Lead Architect)\")\n",
        "        print(\"• Source Document: 'Auth Architecture RFC'\")\n",
        "        print(\"• Decision Rationale: Chosen to solve cross-device session timeouts.\")\n",
        "        print(\"-----------------------------------------------------------\")\n",
        "\n",
        "    elif question_type == \"billing\":\n",
        "        print(\> \"🤖 Agent Query: 'Who wrote the roadmap for the Billing Gateway v2 project?'\")\n",
        "        print(\"\\n--- Graph Traversal Results ---\")\n",
        "        print(\"• Author: Charlie Brown\")\n",
        "        print(\"• Document: Q4 Billing Roadmap\")\n",
        "        print(\"• Content Summary: Stripe integration scheduled to replace legacy processor by November.\")\n",
        "        print(\"-----------------------------------------------------------\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    schema = initialize_company_brain()\n",
        "    print(\"\\nExecuting Agent Query Trials:\\n\")\n",
        "    company_brain_agent_simulation(\"auth\")\n",
        "    print(\"\\n\")\n",
        "    company_brain_agent_simulation(\"billing\")"
      ],
